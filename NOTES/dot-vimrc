""""""""""""""""""""""""""""""""""""""""""""""
" Misc search and replace notes
"
"	\a	any alphabetic character
"	\m	pattern after it be interpreted as if 'magic' is set
"	\M	pattern after it be interpreted as if 'nomagic' (magic unset)
"	\v	ASCII characters except [0-9a-zA-Z_] have special meaning: "very magic"
"	\V	only backslash & terminating char (usually / or ?) have special meaning
"	\c	interactive query
"
" Examples:
"
" after:    \v       \m       \M       \V         matches ~
"                 'magic' 'nomagic'
"           a        a        a        a          literal 'a'
"           \a       \a       \a       \a         any alphabetic character
"           .        .        \.       \.         any character
"           \.       \.       .        .          literal dot
"           $        $        $        \$         end-of-line
"           *        *        \*       \*         any number of the previous atom
"           ~        ~        \~       \~         latest substitute string
"           ()       \(\)     \(\)     \(\)       group as an atom
"           |        \|       \|       \|         nothing: separates alternatives
"           \\       \\       \\       \\         literal backslash
"           \{       {        {        {          literal curly brace

" :set smartcase   or   :set scs	turn off:	:set noscs
" :set ignorecase  or	:set ic		turn off:	:st noic
"
" pattern  :set ignorecase  :set smartcase	matches
"
" /foo		off		off		foo
" /Foo		off		off		    Foo
" /FOO		off		off		        FOO
"
" /foo		on		off		foo Foo FOO
" /Foo		on		off		foo Foo FOO
" /FOO		on		off		foo Foo FOO
"
" /foo		off		on		foo
" /Foo		off		on		    Foo
" /FOO		off		on		        FOO
"
" /foo		on		on		foo Foo FOO
" /Foo		on		on		    Foo
" /FOO		on		on		        FOO
"
" /\cfoo	-		-		foo Foo FOO
" /\cFoo	-		-		foo Foo FOO
" /\cFOO	-		-		foo Foo FOO
"
" /\Cfoo	-		-		foo
" /\CFoo	-		-		    Foo
" /\CFOO	-		-		        FOO
""""""""""""""""""""""""""""""""""""""""""""""

